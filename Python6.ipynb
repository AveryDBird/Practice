        "import os\n",
        "from os import path\n",
        "import shutil\n",
        "\n",
        "if path.exists(\"textfile.txt\"):\n",
        "  src = path.realpath(\"textfile.txt\")\n",
        "  dst = src + \".bak\"\n",
        "\n",
        "  shutil.copy(src,dst)\n",
        "\n",
